{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/((?!booking-eventos(?:/|$)|_build/|assets/|favicon.ico|robots.txt|sitemap.xml).*)",
      "destination": "/"
    }
  ]
}
